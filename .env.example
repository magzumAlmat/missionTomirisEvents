# Скопируй этот файл в .env и заполни значения:  cp .env.example .env

# --- Telegram (бэкенд) ---
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=8723799396:AAHIGp1aq5mHHp723QBd6SoL0OlgnoFIn-U
# ID чата/группы, куда слать уведомления. Узнать: запусти сервер, напиши боту,
# открой http://localhost:3001/api/chat-id-helper и скопируй chat.id
TELEGRAM_CHAT_ID=
# Адрес сайта, которому разрешены запросы (CORS). * — отовсюду.
ALLOWED_ORIGIN=*
PORT=3001

# --- Второй бот: видео от капитанов ---
# Токен отдельного бота из @BotFather (не тот же, что выше!)
TELEGRAM_VIDEO_BOT_TOKEN=
# ID группы, куда бот складывает видео капитанов.
# У групп id отрицательный (например -1001234567890). Узнать: добавь бота в
# группу, напиши там любое сообщение и открой
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_VIDEO_CHAT_ID=

# --- Фронтенд (Vite) ---
# Адрес бэкенда, куда фронт шлёт «Я прибыл».
VITE_API_URL=http://localhost:3001
# Пароль для страницы админа /#/admin. Пусто = без пароля.
VITE_ADMIN_PASSWORD=
