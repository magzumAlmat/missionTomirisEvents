# Скопируй этот файл в .env и заполни значения:  cp .env.example .env

# --- Telegram (бэкенд) ---
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=8723799396:AAHIGp1aq5mHHp723QBd6SoL0OlgnoFIn-U
# ID чата/группы, куда слать уведомления. Узнать: запусти сервер, напиши боту,
# открой http://localhost:3001/api/chat-id-helper и скопируй chat.id
TELEGRAM_CHAT_ID=
# Адрес сайта, которому разрешены запросы (CORS). * — отовсюду.
ALLOWED_ORIGIN=*
PORT=3001

# --- Фронтенд (Vite) ---
# Адрес бэкенда, куда фронт шлёт «Я прибыл».
VITE_API_URL=http://localhost:3001
# Пароль для страницы админа /#/admin. Пусто = без пароля.
VITE_ADMIN_PASSWORD=
